# Copy to .env.local (git-ignored) and fill in from Firebase console > Project settings > Your apps > Web app.
# These identify the project and are public in the built app; Firestore rules protect the data.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: use a local Firestore emulator instead of the cloud project (needs JDK 21+), e.g. 127.0.0.1:8080
# EXPO_PUBLIC_FIRESTORE_EMULATOR_HOST=
